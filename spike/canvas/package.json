{
  "name": "@reqatlas/spike-canvas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "M0-03 2D 画布 Spike：Domain(ModelBundle) → React Flow 适配层 + 编辑产出 ChangeSet + 性能测量",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5199 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "perf": "tsx scripts/perf-adapter.ts",
    "perf:browser": "tsx scripts/browser-perf.ts"
  },
  "//": "playwright 仅用于可选的浏览器性能自动采集；未安装/未下载 chromium 时 perf:browser 会明确报错。",
  "dependencies": {
    "@reqatlas/testkit": "workspace:*",
    "@xyflow/react": "^12.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.49.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
