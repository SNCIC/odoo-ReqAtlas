{
  "name": "reqatlas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ReqAtlas - 需求调研工作台 monorepo (M0/M1 engineering foundation)",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json,html,css}\" \"packages/**/*.{ts,tsx,json}\" \"docs/engineering/**/*.md\" \"infra/**/*.{yml,md}\" \".github/**/*.yml\" \"package.json\" \"tsconfig.base.json\" \"pnpm-workspace.yaml\" \"eslint.config.js\" \"dependency-cruiser.cjs\" \"README.md\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json,html,css}\" \"packages/**/*.{ts,tsx,json}\" \"docs/engineering/**/*.md\" \"infra/**/*.{yml,md}\" \".github/**/*.yml\" \"package.json\" \"tsconfig.base.json\" \"pnpm-workspace.yaml\" \"eslint.config.js\" \"dependency-cruiser.cjs\" \"README.md\"",
    "test": "pnpm -r run test",
    "arch": "depcruise apps packages --config dependency-cruiser.cjs --output-type err",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm arch"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.9.0",
    "dependency-cruiser": "^16.4.2",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^3.2.4"
  }
}
