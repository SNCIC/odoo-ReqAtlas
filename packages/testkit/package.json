{
  "name": "@reqatlas/testkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/model-bundle.schema.ts",
      "default": "./src/model-bundle.schema.ts"
    },
    "./fixtures": {
      "types": "./src/fixtures.ts",
      "default": "./src/fixtures.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
