# =============================================================================
# ReqAtlas 环境变量样例 (M1 骨架)
# -----------------------------------------------------------------------------
# 复制为 .env 后按需填写。.env 已被 .gitignore 忽略，请勿提交任何真实密钥。
# 本文件仅列出键名与安全的占位值，不包含任何真实凭据。
# =============================================================================

# --- 运行环境 ---
NODE_ENV=development
LOG_LEVEL=info

# --- API 服务 ---
API_HOST=0.0.0.0
API_PORT=3000
# 允许的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173

# --- Web 前端 ---
WEB_PORT=5173
# 前端访问 API 的基础地址（Vite dev proxy 用）
VITE_API_BASE_URL=http://localhost:3000

# --- 多租户占位（M1 仅做上下文提取，不做真实鉴权）---
# 请求头名称，服务端据此提取 tenant 上下文
TENANT_HEADER=x-tenant-id

# --- PostgreSQL 16 + pgvector ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=reqatlas
POSTGRES_USER=reqatlas
POSTGRES_PASSWORD=reqatlas_dev_only

# --- Redis 7 (BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- MinIO (对象存储) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=reqatlas
MINIO_ROOT_PASSWORD=reqatlas_dev_only
MINIO_BUCKET=reqatlas

# --- Keycloak (OIDC, 尚未接入) ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=reqatlas
KEYCLOAK_CLIENT_ID=reqatlas-web

# --- ClamAV ---
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
